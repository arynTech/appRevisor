{
  "expo": {
    "name": "PadelYa",
    "slug": "padelya",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "es.padelya.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location"
      }
    },
    "android": {
      "package": "es.padelya.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": { "targetSdkVersion": 34, "compileSdkVersion": 35 }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        { "photosPermission": "Allow $(PRODUCT_NAME) to access your photos" }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.padelya.example/v1",
      "privacyPolicyUrl": "https://padelya.example/privacidad"
    }
  }
}
